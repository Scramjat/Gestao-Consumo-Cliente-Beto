# Copie este arquivo para "backup.env" (na mesma pasta) e preencha.
# O backup.env tem senhas: ele está no .gitignore e nunca deve ser enviado.
# Escreva logo depois do "=", sem espaços e sem comentário na mesma linha.
# Para conferir:  node scripts/backup.js checar

# 1) Banco que será copiado.
#    No site do Neon: seu projeto -> botão "Connect" -> DESLIGUE "Connection pooling"
#    (o endereço não pode ter "-pooler") -> copie o texto que começa com postgresql://
DATABASE_URL=

# 2) Senha que protege os arquivos de cópia (12 caracteres ou mais). Invente uma
#    nova. Sem ela, NENHUMA cópia abre: guarde também fora deste computador.
BACKUP_SENHA=

# 3) O PostgreSQL deste computador, usado para testar cada cópia num banco
#    temporário (que é apagado em seguida). Formato, trocando SUA_SENHA pela senha
#    do usuário "postgres" que você escolheu ao instalar:
#      postgresql://postgres:SUA_SENHA@127.0.0.1:5432/postgres
#    Se a senha tiver estes sinais, troque cada um assim:
#      @ por %40    # por %23    / por %2F    ? por %3F    : por %3A    % por %25
VERIFICAR_URL=

# Onde salvar. De preferência uma pasta sincronizada com a nuvem (OneDrive, Drive).
BACKUP_PASTA=backups

# Por quantos dias guardar (as 7 mais novas ficam sempre)
BACKUP_DIAS=30

# Pasta "bin" do PostgreSQL
PG_BIN=C:\Program Files\PostgreSQL\18\bin

# Só preencha na hora de restaurar: um banco NOVO e VAZIO
DESTINO_URL=
